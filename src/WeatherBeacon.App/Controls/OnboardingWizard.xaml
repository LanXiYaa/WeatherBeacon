<UserControl x:Class="WeatherBeacon.Controls.OnboardingWizard" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Visibility="Collapsed" KeyboardNavigation.TabNavigation="Cycle" KeyboardNavigation.ControlTabNavigation="Cycle" PreviewKeyDown="Wizard_KeyDown" AutomationProperties.Name="WeatherBeacon 使用引导">
 <Grid x:Name="Shade" Background="#FF142B3B">
  <Grid Margin="40,28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="110"/><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
   <DockPanel x:Name="Header"><Button Content="稍后设置" DockPanel.Dock="Right" VerticalAlignment="Top" Click="Cancel_Click" Background="#344D5D"/><StackPanel><TextBlock Text="欢迎使用 WeatherBeacon" FontFamily="/WeatherBeacon;component/Assets/Fonts/#Source Han Serif SC" FontSize="27" Foreground="#F5F2E9"/><TextBlock Text="让桌面天气符合你的习惯" Foreground="#92DAD5" Margin="0,8,0,16"/></StackPanel></DockPanel>
   <Grid x:Name="Steps" Grid.Row="1" Margin="0,10,0,14"/>
   <Border x:Name="Card" Grid.Row="2" Background="#B9233E4C" BorderBrush="#526D9298" BorderThickness="1" CornerRadius="16" Padding="26,20">
    <ScrollViewer VerticalScrollBarVisibility="Auto"><Grid x:Name="Pages">
     <StackPanel x:Name="StartupPage"><TextBlock Text="登录后，天气自动就位" FontSize="22"/><TextBlock Text="开启后仅显示小组件，不会弹出设置窗口。" Foreground="#C1D2D8" Margin="0,12,0,24"/><DockPanel><ToggleButton x:Name="StartupChoice" Style="{DynamicResource ToggleSwitch}" DockPanel.Dock="Right" AutomationProperties.Name="引导开机自启"/><TextBlock Text="开机自启" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="StartupHint" TextWrapping="Wrap" Foreground="#E8C783" Margin="0,16,0,0"/></StackPanel>
     <StackPanel x:Name="CityPage" Visibility="Collapsed"><TextBlock Text="你想关注哪座城市？" FontSize="22"/><TextBlock x:Name="ChosenCity" Foreground="#E8C783" Margin="0,12,0,18"/><DockPanel><Button x:Name="Locate" Content="IP 定位" DockPanel.Dock="Right" Margin="10,0,0,0" Click="Locate_Click"/><Button x:Name="Search" Content="搜索" DockPanel.Dock="Right" Margin="10,0,0,0" Click="Search_Click"/><TextBox x:Name="CityQuery" AutomationProperties.Name="城市名称" ToolTip="输入城市名称，按 Enter 搜索" KeyDown="CityQuery_KeyDown"/></DockPanel><TextBlock Text="IP 定位使用 ipwho.is 与小米城市搜索，VPN 可能影响结果。请选中列表里的城市确认。" TextWrapping="Wrap" FontSize="12" Foreground="#C1D2D8" Margin="0,12"/><ListBox x:Name="CityResults" Height="140" DisplayMemberPath="Name" SelectionChanged="City_Selected" AutomationProperties.Name="城市搜索结果"/></StackPanel>
     <StackPanel x:Name="ThemePage" Visibility="Collapsed"><TextBlock Text="选择设置窗口的材质" FontSize="22"/><TextBlock Text="沿用当前装饰艺术配色与思源字体；天气小组件继续使用动态天气背景。" TextWrapping="Wrap" Foreground="#C1D2D8" Margin="0,12,0,20"/><ComboBox x:Name="ThemeChoice" SelectedIndex="0" AutomationProperties.Name="引导主题材质"><ComboBoxItem Content="云母 · Mica"/><ComboBoxItem Content="云母 Alt"/><ComboBoxItem Content="亚克力 · Acrylic"/><ComboBoxItem Content="纯色"/></ComboBox><TextBlock Text="不支持系统材质时使用纯色背景。完成引导后应用选择。" TextWrapping="Wrap" Foreground="#E8C783" Margin="0,18,0,0"/></StackPanel>
     <StackPanel x:Name="PrivacyPage" Visibility="Collapsed"><TextBlock Text="系统信息收集授权" FontSize="22"/><TextBlock Text="日志只保存在本机，用于排查错误；只有你在设置里点击“复制诊断信息”或“打包日志”时才会导出。" TextWrapping="Wrap" Foreground="#E8C783" Margin="0,12,0,16"/><TextBlock Text="同意后，诊断信息会额外包含以下全部系统信息：&#10;• 系统版本及版本类型（例如 Windows 11 家庭版）&#10;• 显卡型号&#10;• CPU 型号&#10;• 内存容量" TextWrapping="Wrap" Foreground="#C1D2D8" LineHeight="26"/><DockPanel Margin="0,20,0,0"><ToggleButton x:Name="ConsentChoice" DockPanel.Dock="Right" Style="{DynamicResource ToggleSwitch}" AutomationProperties.Name="同意在诊断信息中包含所列系统信息"/><TextBlock Text="同意在诊断信息中包含上述系统信息" VerticalAlignment="Center"/></DockPanel><TextBlock Text="默认不同意，不影响使用天气功能；可重新运行引导修改选择。未同意时上述字段为 null。日志还会记录运行事件、错误和应用设置（如所选城市），不收集其他个人信息。" TextWrapping="Wrap" FontSize="12" Foreground="#C1D2D8" Margin="0,12,0,0"/></StackPanel>
    </Grid></ScrollViewer>
   </Border>
   <Grid x:Name="Footer" Grid.Row="3" Margin="0,18,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="12"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="Hint" TextWrapping="Wrap" Foreground="#E8C783" VerticalAlignment="Center" Margin="0,0,16,0"/><Button x:Name="Previous" Grid.Column="1" Content="上一步" Click="Previous_Click" Background="#344D5D"/><Button x:Name="Next" Grid.Column="3" Content="下一步" Click="Next_Click" MinWidth="110"/></Grid>
  </Grid>
 </Grid>
</UserControl>
