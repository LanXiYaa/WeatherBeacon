<Window x:Class="WeatherBeacon.Features.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WeatherBeacon · 应用设置 · 1.0.0.0" Width="960" Height="740" MinWidth="850" MinHeight="600" Background="#17171C" Foreground="#ECECF1" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F2F5"/></Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="#D92A2A32"/><Setter Property="BorderBrush" Value="#4A474754"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20,18"/><Setter Property="Margin" Value="0,0,0,10"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="FontSize" Value="23"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="Margin" Value="0,0,0,5"/></Style>
  <Style x:Key="SectionSubtitle" TargetType="TextBlock"><Setter Property="FontSize" Value="12"/><Setter Property="Foreground" Value="#A1A5B1"/><Setter Property="Margin" Value="0,0,0,22"/></Style>
  <Style x:Key="CardTitle" TargetType="TextBlock"><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="14"/></Style>
  <Style x:Key="CardHint" TargetType="TextBlock"><Setter Property="Foreground" Value="#A5A8B3"/><Setter Property="FontSize" Value="11"/><Setter Property="Margin" Value="0,6,0,0"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EEF7E9"/><Setter Property="Background" Value="#3E5D33"/><Setter Property="Padding" Value="18,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#527842"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Setter TargetName="B" Property="Background" Value="#304A28"/></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#B5E786"/><Setter TargetName="B" Property="BorderThickness" Value="1"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value="0.45"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#CC1D1D24"/><Setter Property="Foreground" Value="#EEEEF4"/><Setter Property="CaretBrush" Value="#B4E889"/><Setter Property="BorderBrush" Value="#5B5B68"/><Setter Property="Padding" Value="10,8"/></Style>
  <Style TargetType="ListBox"><Setter Property="Background" Value="#C4202027"/><Setter Property="Foreground" Value="#E6E6EB"/><Setter Property="BorderThickness" Value="0"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,11"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#34343D"/></Trigger><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#3E5834"/><Setter Property="Foreground" Value="#C4EFA5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECECF1"/><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border x:Name="ComboBorder" Background="#D9202027" BorderBrush="#555560" BorderThickness="1" CornerRadius="7"><TextBlock Text="⌄" Foreground="#C8CDD5" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboBorder" Property="Background" Value="#E3272730"/></Trigger></ControlTemplate.Triggers></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,8,30,8" IsHitTestVisible="False"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#F0272730" BorderBrush="#5B5B68" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="210"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECECF1"/><Setter Property="Padding" Value="12,9"/><Setter Property="Background" Value="#272730"/></Style>
  <Style x:Key="ToggleSwitch" TargetType="ToggleButton">
   <Setter Property="Width" Value="50"/><Setter Property="Height" Value="28"/><Setter Property="Cursor" Value="Hand"/><Setter Property="Focusable" Value="True"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/><Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="ToggleButton"><Grid Background="Transparent"><Border x:Name="FocusRing" CornerRadius="15" BorderBrush="Transparent" BorderThickness="2"/><Border CornerRadius="14" Background="#4A4A56" Margin="2,2"><Grid ClipToBounds="True"><Border x:Name="OnTrack" Background="#6FB94A" CornerRadius="12" Opacity="0"/><Border Background="#4A4A56" CornerRadius="12"/></Grid></Border><Ellipse x:Name="Thumb" Width="20" Height="20" Fill="#F4F5F2" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="4,0,0,0" RenderTransformOrigin="0.5,0.5"><Ellipse.RenderTransform><TransformGroup><ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1"/><TranslateTransform x:Name="ThumbTransform" X="0"/></TransformGroup></Ellipse.RenderTransform></Ellipse></Grid>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="22" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="1" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbTransform" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation><DoubleAnimation Storyboard.TargetName="OnTrack" Storyboard.TargetProperty="Opacity" To="0" Duration="0:0:0.18"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#667F9B5E"/></Trigger>
     <Trigger Property="IsPressed" Value="True"><Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="0.9" Duration="0:0:0.08"/><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="0.9" Duration="0:0:0.08"/></Storyboard></BeginStoryboard></Trigger.EnterActions><Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.12"/><DoubleAnimation Storyboard.TargetName="ThumbScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.12"/></Storyboard></BeginStoryboard></Trigger.ExitActions></Trigger>
     <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="FocusRing" Property="BorderBrush" Value="#B5E786"/></Trigger>
     <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Thumb" Property="Fill" Value="#8F9298"/><Setter Property="Opacity" Value="0.45"/><Setter Property="Cursor" Value="Arrow"/></Trigger>
    </ControlTemplate.Triggers></ControlTemplate></Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Slider"><Setter Property="Margin" Value="0,7,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24"><Border Height="4" VerticalAlignment="Center" Background="#4A4A56" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#A7DA81" Height="4" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="18" Height="18" Fill="#C2EC9E" Stroke="#263021" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Background="#6017171C">
  <Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="62"/></Grid.RowDefinitions>
  <Border Background="#D91E271D" BorderBrush="#526D42" BorderThickness="0,0,0,1"><DockPanel Margin="26,0"><TextBlock Text="1.0.0.0" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#B6E794"/><StackPanel VerticalAlignment="Center"><TextBlock Text="应用设置" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="WEATHERBEACON" FontSize="10" Foreground="#B5E891" Margin="1,4,0,0"/></StackPanel></DockPanel></Border>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
   <Border Background="#D117171D" Padding="14,25"><DockPanel><TextBlock DockPanel.Dock="Bottom" Text="桌面上的天气，恰到好处。" FontSize="10" Foreground="#858895"/><ListBox x:Name="Navigation" Background="Transparent" SelectionChanged="Navigate" SelectedIndex="0"><ListBoxItem Content="◈    外观"/><ListBoxItem Content="☁    天气"/><ListBoxItem Content="ⓘ    关于"/></ListBox></DockPanel></Border>
   <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,25,28,16">
    <Grid x:Name="PageHost" ClipToBounds="True">
     <StackPanel x:Name="AppearancePage">
      <TextBlock Text="外观" Style="{StaticResource SectionTitle}"/><TextBlock Text="不透明动态天气、自由位置与仅作用于设置窗口的材质" Style="{StaticResource SectionSubtitle}"/>
      <Border Style="{StaticResource Card}"><DockPanel><ToggleButton x:Name="AnimationToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Animations, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="动态天气背景"/><StackPanel><TextBlock Text="动态天气背景" Style="{StaticResource CardTitle}"/><TextBlock Text="约 30 fps；手动隐藏或被完全遮挡时自动暂停。关闭后保留同一天气的静态细节画面。" Style="{StaticResource CardHint}"/></StackPanel></DockPanel></Border>
      <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Right" Width="210"><TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="#B6E794" HorizontalAlignment="Right"/><Slider Minimum="0.2" Maximum="1" Value="{Binding Opacity}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="整体不透明度" Style="{StaticResource CardTitle}"/><TextBlock Text="默认 100%。仅调整整个小组件，不引入材质透明效果。" Style="{StaticResource CardHint}"/></StackPanel></DockPanel></Border>
      <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Right" Width="210"><TextBlock Text="{Binding Radius, StringFormat={}{0:F0} px}" Foreground="#B6E794" HorizontalAlignment="Right"/><Slider Minimum="0" Maximum="48" Value="{Binding Radius}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="圆角半径" Style="{StaticResource CardTitle}"/><TextBlock Text="调整卡片边缘的弧度。" Style="{StaticResource CardHint}"/></StackPanel></DockPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><DockPanel><ComboBox DockPanel.Dock="Right" Width="210" SelectedIndex="{Binding Material, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"><ComboBoxItem Content="云母 · Mica"/><ComboBoxItem Content="云母 Alt"/><ComboBoxItem Content="亚克力 · Acrylic"/><ComboBoxItem Content="纯色"/></ComboBox><StackPanel VerticalAlignment="Center"><TextBlock Text="设置窗口材质" Style="{StaticResource CardTitle}"/><TextBlock Text="只影响设置窗口；小组件始终使用天气画面。" Style="{StaticResource CardHint}"/></StackPanel></DockPanel><TextBlock Text="{Binding MaterialStatus}" Foreground="#E7C984" FontSize="11" TextWrapping="Wrap" Margin="0,12,0,0"/></StackPanel></Border>
      <Border Style="{StaticResource Card}"><DockPanel><ToggleButton x:Name="LockPositionToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding LockPosition, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" VerticalAlignment="Center" AutomationProperties.Name="锁定位置"/><StackPanel><TextBlock Text="锁定位置" Style="{StaticResource CardTitle}"/><TextBlock Text="直接拖动小组件即可放到任意位置；松开后自动保存。锁定后不再响应拖动。" Style="{StaticResource CardHint}"/><Button Content="重置位置" Click="ResetPosition_Click" HorizontalAlignment="Left" Margin="0,12,0,0"/></StackPanel></DockPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="桌面诊断" FontWeight="SemiBold"/><TextBlock Text="{Binding DesktopStatus}" TextWrapping="Wrap" Foreground="#EBCB8A" Margin="0,8"/><Button Content="打开诊断日志文件夹" Click="OpenDiagnostics" HorizontalAlignment="Left"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="WeatherPage" Visibility="Collapsed">
<Border Style="{StaticResource Card}"><StackPanel><DockPanel><ToggleButton x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" Click="Startup_Click" AutomationProperties.Name="开机自启"/><TextBlock Text="开机自启" VerticalAlignment="Center"/></DockPanel><TextBlock x:Name="StartupStatus" TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border>
<Border Style="{StaticResource Card}"><DockPanel><ComboBox x:Name="RefreshOptions" Width="210" DockPanel.Dock="Right" SelectedItem="{Binding RefreshMinutes, Mode=TwoWay}"/><TextBlock Text="自动刷新间隔（分钟）" VerticalAlignment="Center"/></DockPanel></Border>
<Border Style="{StaticResource Card}"><DockPanel><ToggleButton DockPanel.Dock="Right" Style="{StaticResource ToggleSwitch}" IsChecked="{Binding Fahrenheit, Mode=TwoWay}" AutomationProperties.Name="使用华氏温度"/><TextBlock Text="使用华氏温度 ℉（关闭为 ℃）" VerticalAlignment="Center"/></DockPanel></Border>
<Border Style="{StaticResource Card}"><StackPanel><Button x:Name="LocateButton" Content="IP 自动定位" Click="Locate_Click" HorizontalAlignment="Left"/><TextBlock Text="点击后向 ipwho.is 查询公网 IP 大致位置，再通过小米匹配城市；结果请确认后使用。VPN 或运营商出口可能影响定位。" TextWrapping="Wrap" Margin="0,10,0,0" Foreground="#A9ADB7"/><TextBlock Text="暂无分钟级降水预报，不根据小时数据估算分钟。" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#E7C984"/></StackPanel></Border>
      <TextBlock Text="天气" Style="{StaticResource SectionTitle}"/><TextBlock Text="选择城市并刷新天气数据" Style="{StaticResource SectionSubtitle}"/>
      <Border Style="{StaticResource Card}"><DockPanel><ComboBox DockPanel.Dock="Right" Width="210" SelectedIndex="0"><ComboBoxItem Content="小米天气"/></ComboBox><TextBlock Text="天气数据源" VerticalAlignment="Center"/></DockPanel></Border>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="城市" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CurrentCity" Margin="0,9,0,18" Foreground="#B6E794"/><DockPanel><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="搜索" Click="Search_Click" Margin="10,0,0,0"/><TextBox x:Name="Query" ToolTip="输入城市名称"/></DockPanel><ListBox x:Name="Results" DisplayMemberPath="Name" Height="170" Margin="0,14"/><Button Content="使用选中城市" HorizontalAlignment="Right" Click="SelectCity_Click"/></StackPanel></Border>
     </StackPanel>
     <StackPanel x:Name="AboutPage" Visibility="Collapsed">
      <TextBlock Text="关于 WeatherBeacon" Style="{StaticResource SectionTitle}"/><TextBlock Text="1.0.0.0 · x64" Style="{StaticResource SectionSubtitle}"/>
      <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WeatherBeacon" FontSize="28"/><TextBlock Text="1.0.0.0 · x64" Foreground="#B6E794" Margin="0,12"/><TextBlock Text="不透明天气画面、桌面自由拖动、设置材质与滑块开关。&#10;自启、城市定位、刷新恢复、温度单位与单实例。" TextWrapping="Wrap" LineHeight="25" Foreground="#A9ADB7"/></StackPanel></Border>
     </StackPanel>
    </Grid>
   </ScrollViewer>
  </Grid>
  <Border Grid.Row="2" Background="#B817171C" BorderBrush="#494952" BorderThickness="0,1,0,0"><DockPanel Margin="24,10"><Button DockPanel.Dock="Right" Content="保存设置" Click="Save_Click"/><TextBlock x:Name="Status" Text="外观实时预览；拖动松开后位置自动保存。" FontSize="11" Foreground="#ADB1BC" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
 </Grid>
</Window>


