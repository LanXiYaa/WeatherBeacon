<Window x:Class="WeatherBeacon.Features.Settings.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="WeatherBeacon · 应用设置 · 1.0.0.0" Width="960" Height="740" MinWidth="850" MinHeight="600" Background="#17171C" Foreground="#ECECF1" FontFamily="Microsoft YaHei UI" WindowStartupLocation="CenterScreen">
<Window.Resources>
 <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#ECECF1"/></Style>
 <Style x:Key="Card" TargetType="Border"><Setter Property="Background" Value="#2A2A32"/><Setter Property="BorderBrush" Value="#383840"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="8"/><Setter Property="Padding" Value="20,18"/><Setter Property="Margin" Value="0,0,0,10"/></Style>
 <Style TargetType="Button"><Setter Property="Foreground" Value="#DDEAD6"/><Setter Property="Background" Value="#384D31"/><Setter Property="Padding" Value="18,9"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#4B663D"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="TextBox"><Setter Property="Background" Value="#1D1D24"/><Setter Property="Foreground" Value="#EEEEF4"/><Setter Property="CaretBrush" Value="#A6DF79"/><Setter Property="BorderBrush" Value="#555563"/><Setter Property="Padding" Value="10,8"/></Style>
 <Style TargetType="ListBox"><Setter Property="Background" Value="#202027"/><Setter Property="Foreground" Value="#E6E6EB"/><Setter Property="BorderThickness" Value="0"/></Style>
 <Style TargetType="ListBoxItem"><Setter Property="Padding" Value="12,12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><Border x:Name="B" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}" Margin="3"><ContentPresenter/></Border><ControlTemplate.Triggers><Trigger Property="IsSelected" Value="True"><Setter TargetName="B" Property="Background" Value="#35472F"/><Setter Property="Foreground" Value="#B2EB85"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#ECECF1"/><Setter Property="MinHeight" Value="36"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox"><Grid><ToggleButton IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" Focusable="False"><ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="#202027" BorderBrush="#494952" BorderThickness="0,0,0,1" CornerRadius="4"><TextBlock Text="⌄" HorizontalAlignment="Right" Margin="0,0,12,0" VerticalAlignment="Center"/></Border></ControlTemplate></ToggleButton.Template></ToggleButton><ContentPresenter Content="{TemplateBinding SelectionBoxItem}" Margin="12,8,30,8" IsHitTestVisible="False"/><Popup IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False"><Border Background="#272730" BorderBrush="#494952" BorderThickness="1" Padding="4" MinWidth="210"><StackPanel IsItemsHost="True"/></Border></Popup></Grid></ControlTemplate></Setter.Value></Setter></Style>
 <Style TargetType="ComboBoxItem"><Setter Property="Foreground" Value="#ECECF1"/><Setter Property="Padding" Value="12,9"/></Style>
 <Style TargetType="CheckBox"><Setter Property="Foreground" Value="#BBE99A"/></Style>
 <Style TargetType="Slider"><Setter Property="Margin" Value="0,7,0,0"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Slider"><Grid Height="24"><Border Height="4" VerticalAlignment="Center" Background="#47543F" CornerRadius="2"/><Track x:Name="PART_Track"><Track.DecreaseRepeatButton><RepeatButton Command="Slider.DecreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="#A5DB75" Height="4" VerticalAlignment="Center"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.DecreaseRepeatButton><Track.Thumb><Thumb><Thumb.Template><ControlTemplate TargetType="Thumb"><Ellipse Width="17" Height="17" Fill="#B3EA82" Stroke="#263021" StrokeThickness="2"/></ControlTemplate></Thumb.Template></Thumb></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="Slider.IncreaseLarge"><RepeatButton.Template><ControlTemplate TargetType="RepeatButton"><Border Background="Transparent"/></ControlTemplate></RepeatButton.Template></RepeatButton></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
</Window.Resources>
<Grid Background="#F217171C"><Grid.RowDefinitions><RowDefinition Height="76"/><RowDefinition/><RowDefinition Height="62"/></Grid.RowDefinitions>
 <Border Background="#242C24" BorderBrush="#526D42" BorderThickness="0,0,0,1"><DockPanel Margin="26,0"><TextBlock Text="1.0.0.0" DockPanel.Dock="Right" VerticalAlignment="Center" Foreground="#A7DA81"/><StackPanel VerticalAlignment="Center"><TextBlock Text="应用设置" FontSize="22" FontWeight="SemiBold"/><TextBlock Text="WEATHERBEACON" FontSize="10" Foreground="#A7DA81" Margin="1,4,0,0"/></StackPanel></DockPanel></Border>
 <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="190"/><ColumnDefinition/></Grid.ColumnDefinitions>
 <Border Background="#19191F" Padding="14,25"><DockPanel><TextBlock DockPanel.Dock="Bottom" Text="桌面上的天气，恰到好处。" FontSize="10" Foreground="#737582"/><ListBox x:Name="Navigation" Background="Transparent" SelectionChanged="Navigate" SelectedIndex="0"><ListBoxItem Content="◈    外观"/><ListBoxItem Content="☁    天气"/><ListBoxItem Content="ⓘ    关于"/></ListBox></DockPanel></Border>
 <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,25,28,16"><StackPanel>
 <StackPanel x:Name="AppearancePage"><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="桌面诊断" FontWeight="SemiBold"/><TextBlock Text="{Binding DesktopStatus}" TextWrapping="Wrap" Foreground="#EBCB8A" Margin="0,8"/><Button Content="打开诊断日志文件夹" Click="OpenDiagnostics" HorizontalAlignment="Left"/></StackPanel></Border><TextBlock Text="外观" FontSize="23" Margin="0,0,0,5"/><TextBlock Text="让天气融入桌面" FontSize="12" Foreground="#9396A3" Margin="0,0,0,23"/>
 <Border Style="{StaticResource Card}"><DockPanel><CheckBox DockPanel.Dock="Right" Content="启用动画" IsChecked="{Binding Animations}" VerticalAlignment="Center"/><StackPanel><TextBlock Text="动态天气背景" FontWeight="SemiBold"/><TextBlock Text="关闭后保留静态画面；隐藏时暂停动画。" Foreground="#999BA8" FontSize="11" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
 <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Right" Width="210"><TextBlock Text="{Binding Opacity, StringFormat={}{0:P0}}" Foreground="#A6DF79" HorizontalAlignment="Right"/><Slider Minimum="0.2" Maximum="1" Value="{Binding Opacity}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="背景不透明度" FontWeight="SemiBold"/><TextBlock Text="调整整个桌面小组件的不透明度。" Foreground="#999BA8" FontSize="11" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
 <Border Style="{StaticResource Card}"><DockPanel><StackPanel DockPanel.Dock="Right" Width="210"><TextBlock Text="{Binding Radius, StringFormat={}{0:F0} px}" Foreground="#A6DF79" HorizontalAlignment="Right"/><Slider Minimum="0" Maximum="48" Value="{Binding Radius}"/></StackPanel><StackPanel VerticalAlignment="Center"><TextBlock Text="圆角半径" FontWeight="SemiBold"/><TextBlock Text="调整卡片边缘的弧度。" Foreground="#999BA8" FontSize="11" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
 <Border Style="{StaticResource Card}"><DockPanel><ComboBox DockPanel.Dock="Right" Width="210" SelectedIndex="{Binding Material}"><ComboBoxItem Content="云母 · Mica"/><ComboBoxItem Content="云母 Alt"/><ComboBoxItem Content="亚克力 · Acrylic"/><ComboBoxItem Content="纯色"/></ComboBox><StackPanel><TextBlock Text="背景材质" FontWeight="SemiBold"/><TextBlock Text="小组件使用近似材质。" Foreground="#999BA8" FontSize="11" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
 <Border Style="{StaticResource Card}"><DockPanel><ComboBox DockPanel.Dock="Right" Width="210" SelectedIndex="{Binding Position}"><ComboBoxItem Content="左上"/><ComboBoxItem Content="右上"/><ComboBoxItem Content="左下"/><ComboBoxItem Content="右下"/></ComboBox><StackPanel><TextBlock Text="桌面位置" FontWeight="SemiBold"/><TextBlock Text="主显示器工作区，避开任务栏。" Foreground="#999BA8" FontSize="11" Margin="0,6,0,0"/></StackPanel></DockPanel></Border>
 </StackPanel>
 <StackPanel x:Name="WeatherPage" Visibility="Collapsed"><TextBlock Text="天气" FontSize="23" Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><DockPanel><ComboBox DockPanel.Dock="Right" Width="210" SelectedIndex="0"><ComboBoxItem Content="小米天气"/></ComboBox><TextBlock Text="天气数据源" VerticalAlignment="Center"/></DockPanel></Border>
 <Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="城市" FontSize="15" FontWeight="SemiBold"/><TextBlock x:Name="CurrentCity" Margin="0,9,0,18" Foreground="#A6DF79"/><DockPanel><Button x:Name="SearchButton" DockPanel.Dock="Right" Content="搜索" Click="Search_Click" Margin="10,0,0,0"/><TextBox x:Name="Query" ToolTip="输入城市名称"/></DockPanel><ListBox x:Name="Results" DisplayMemberPath="Name" Height="170" Margin="0,14"/><Button Content="使用选中城市" HorizontalAlignment="Right" Click="SelectCity_Click"/></StackPanel></Border></StackPanel>
 <StackPanel x:Name="AboutPage" Visibility="Collapsed"><TextBlock Text="关于 WeatherBeacon" FontSize="23" Margin="0,0,0,24"/><Border Style="{StaticResource Card}"><StackPanel><TextBlock Text="WeatherBeacon" FontSize="28"/><TextBlock Text="1.0.0.0 · 桌面行为修复 / x64" Foreground="#A6DF79" Margin="0,12"/><TextBlock Text="天气动态背景与矢量图标。&#10;首次引导、自启动、预警与日志将在后续阶段提供。" TextWrapping="Wrap" LineHeight="25" Foreground="#9FA4AF"/></StackPanel></Border></StackPanel>
 </StackPanel></ScrollViewer></Grid>
 <Border Grid.Row="2" BorderBrush="#32323B" BorderThickness="0,1,0,0"><DockPanel Margin="24,10"><Button DockPanel.Dock="Right" Content="保存设置" Click="Save_Click"/><TextBlock x:Name="Status" Text="外观实时预览，保存后下次启动保留。" FontSize="11" Foreground="#9DA5AF" VerticalAlignment="Center" TextWrapping="Wrap"/></DockPanel></Border>
</Grid></Window>

