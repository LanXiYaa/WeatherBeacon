<Window x:Class="WeatherBeacon.Features.Widget.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:visual="clr-namespace:WeatherBeacon.Controls" Title="WeatherBeacon 1.0.0.0" Width="420" Height="430" FontFamily="Microsoft YaHei UI" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False">
 <Window.Resources>
  <DataTemplate x:Key="Forecast">
   <Border x:Name="Tile" CornerRadius="10" Padding="5,7" Margin="2,0" Background="#30030A12">
    <StackPanel Width="52">
     <visual:WeatherIcon Kind="{Binding Kind}" Width="32" Height="32" HorizontalAlignment="Center"/>
     <TextBlock Text="{Binding Time}" Foreground="#E4EDF4" FontSize="10.5" HorizontalAlignment="Center" Margin="0,3,0,5"/>
     <TextBlock Text="{Binding Temperature}" Foreground="#A9C2D3" FontSize="9.5" HorizontalAlignment="Center"/>
    </StackPanel>
   </Border>
   <DataTemplate.Triggers>
    <DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Tile" Property="Background" Value="#7001060D"/><Setter TargetName="Tile" Property="BorderBrush" Value="#467AA6C2"/><Setter TargetName="Tile" Property="BorderThickness" Value="1"/></DataTrigger>
   </DataTemplate.Triggers>
  </DataTemplate>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="24" Background="#1A3044" BorderBrush="#6C94A9BA" BorderThickness="1">
  <Grid x:Name="SceneClip">
   <visual:WeatherScene x:Name="Scene" Kind="{Binding Kind}"/>
   <Grid Margin="18,16">
    <Grid.RowDefinitions>
     <RowDefinition Height="30"/><RowDefinition Height="8"/><RowDefinition Height="118"/><RowDefinition Height="8"/>
     <RowDefinition Height="100"/><RowDefinition Height="8"/><RowDefinition Height="96"/><RowDefinition Height="8"/><RowDefinition Height="20"/>
    </Grid.RowDefinitions>
    <Border Background="#7807111A" CornerRadius="12" Padding="11,0">
     <DockPanel>
      <TextBlock Text="WEATHER / BEACON" FontFamily="Segoe UI" FontSize="8.5" Foreground="#A4C3D5" DockPanel.Dock="Right" VerticalAlignment="Center"/>
      <TextBlock Text="{Binding City}" Foreground="#F1F6FA" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
     </DockPanel>
    </Border>
    <Border Grid.Row="2" Background="#7807111A" CornerRadius="17" Padding="14,10">
     <Grid>
      <StackPanel VerticalAlignment="Center">
       <TextBlock Text="{Binding Temperature}" Foreground="#FFFFFF" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" FontSize="62" LineHeight="66"/>
       <TextBlock Text="{Binding Description}" Foreground="#C3D6E3" FontSize="13" Margin="3,1,0,0"/>
      </StackPanel>
      <visual:WeatherIcon x:Name="CurrentWeatherIcon" Kind="{Binding Kind}" Width="86" Height="86" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,4,0"/>
     </Grid>
    </Border>
    <Border Grid.Row="4" Background="#76060E18" CornerRadius="13" Padding="7,5">
     <ScrollViewer x:Name="HoursScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
      <ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource Forecast}">
       <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
      </ItemsControl>
     </ScrollViewer>
    </Border>
    <Border Grid.Row="6" Background="#76060E18" CornerRadius="13" Padding="7,5">
     <ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource Forecast}">
      <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
     </ItemsControl>
    </Border>
    <Border Grid.Row="8" Background="#6007111A" CornerRadius="9" Padding="9,0">
     <TextBlock Text="{Binding Status}" Foreground="#AFC3D1" FontSize="9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
    </Border>
   </Grid>
  </Grid>
 </Border>
</Window>

