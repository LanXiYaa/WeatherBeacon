<Window x:Class="WeatherBeacon.Features.Widget.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:visual="clr-namespace:WeatherBeacon.Controls" Title="WeatherBeacon 1.0.0.0" Width="460" Height="626" FontFamily="Microsoft YaHei UI" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False">
 <Window.Resources>
  <Style x:Key="Glass" TargetType="Border"><Setter Property="Background" Value="#0CFFFFFF"/><Setter Property="BorderBrush" Value="#20FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="16"/></Style>
  <DataTemplate x:Key="Hour"><StackPanel Width="70" Margin="2,0"><TextBlock Text="{Binding Time}" Foreground="#ADFFFFFF" FontSize="11" HorizontalAlignment="Center"/><visual:WeatherIcon Kind="{Binding Kind}" Width="39" Height="39" Margin="0,13,0,10"/><TextBlock Text="{Binding Temperature}" Foreground="White" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="Day"><Border x:Name="Tile" Background="#06FFFFFF" CornerRadius="16" BorderThickness="1" BorderBrush="Transparent" Padding="3,12" Margin="3,0"><StackPanel Width="60"><TextBlock x:Name="DayLabel" Text="{Binding Description}" ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="#85FFFFFF" FontSize="10" HorizontalAlignment="Center"/><TextBlock Text="{Binding Time}" Foreground="White" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,5,0,8"/><visual:WeatherIcon Kind="{Binding Kind}" Width="36" Height="36"/><TextBlock Text="{Binding Temperature}" Foreground="#C0FFFFFF" FontSize="10" HorizontalAlignment="Center" Margin="0,12,0,0"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Tile" Property="Background" Value="#20FFFFFF"/><Setter TargetName="Tile" Property="BorderBrush" Value="#70FFFFFF"/><Setter TargetName="DayLabel" Property="Foreground" Value="#FBBF24"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="34" BorderBrush="#60FFFFFF" BorderThickness="1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".7,1"><GradientStop Color="#AE493B36" Offset="0"/><GradientStop Color="#D42F2332" Offset=".55"/><GradientStop Color="#ED1D1D2A" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid x:Name="SceneClip">
   <visual:WeatherScene x:Name="Scene" Kind="{Binding Kind}" Opacity=".28"><visual:WeatherScene.Effect><BlurEffect Radius="28" RenderingBias="Performance"/></visual:WeatherScene.Effect></visual:WeatherScene>
   <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint=".6,1"><GradientStop Color="#703E2E2C"/><GradientStop Color="#B0221C26" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Ellipse Width="210" Height="210" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,8,0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40FBBF24"/><GradientStop Color="#00FBBF24" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   <Grid Margin="26,27,26,23"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="142"/><RowDefinition Height="168"/><RowDefinition Height="16"/><RowDefinition Height="184"/><RowDefinition Height="28"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="133"/></Grid.ColumnDefinitions><Border Background="#10FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="17" Padding="10,0"><DockPanel><Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#34D399" Margin="0,0,7,0"/><TextBlock Text="{Binding City}" ToolTip="{Binding City}" Foreground="#EDFFFFFF" FontSize="11" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Border><TextBlock Grid.Column="1" Text="WEATHER / BEACON" Foreground="#80FFFFFF" FontFamily="Segoe UI" FontWeight="SemiBold" FontSize="9" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid Grid.Row="1" Margin="4,8,4,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Temperature}" Foreground="#FAFFFFFF" FontFamily="Segoe UI" FontWeight="ExtraLight" FontSize="78"/><Border Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="14" Padding="10,4" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#FBBF24" Margin="0,0,7,0"/><TextBlock Text="{Binding Description}" Foreground="#DEFFFFFF" FontSize="11"/></StackPanel></Border></StackPanel><visual:WeatherIcon x:Name="CurrentWeatherIcon" Kind="{Binding Kind}" Width="108" Height="108" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Border Grid.Row="2" Style="{StaticResource Glass}"><StackPanel><TextBlock Text="◷  逐小时预报" Foreground="#9FFFFFFF" FontSize="11" Margin="4,0,0,20"/><ScrollViewer x:Name="HoursScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource Hour}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></StackPanel></Border>
    <Border Grid.Row="4" Style="{StaticResource Glass}"><StackPanel><TextBlock Text="▣  未来 5 日预报" Foreground="#9FFFFFFF" FontSize="11" Margin="4,0,0,13"/><ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource Day}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border>
    <TextBlock Grid.Row="5" ToolTip="{Binding RainHint}" Text="{Binding Status}" Foreground="#75FFFFFF" FontSize="10" Margin="4,0,0,0" VerticalAlignment="Bottom"/>
   </Grid>
  </Grid>
 </Border>
</Window>

