<Window x:Class="WeatherBeacon.Features.Widget.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:visual="clr-namespace:WeatherBeacon.Controls" Title="WeatherBeacon 1.0.0.0" Width="420" Height="430" FontFamily="Microsoft YaHei UI" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False">
 <Window.Resources>
  <DataTemplate x:Key="Forecast"><Border x:Name="Tile" CornerRadius="13" Padding="5,10" Margin="2,0"><StackPanel Width="57"><visual:WeatherIcon Kind="{Binding Kind}" Width="38" Height="38"/><TextBlock Text="{Binding Time}" Foreground="#DBE4EF" FontSize="11" HorizontalAlignment="Center" Margin="0,4,0,6"/><TextBlock Text="{Binding Temperature}" Foreground="#8FABC0" FontSize="10" HorizontalAlignment="Center"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Tile" Property="Background" Value="#80060E18"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
 </Window.Resources>
 <Border x:Name="Shell" CornerRadius="24" Background="#142638" BorderBrush="#405D778B" BorderThickness="1">
 <Grid x:Name="SceneClip"><visual:WeatherScene x:Name="Scene" Kind="{Binding Kind}"/>
  <Grid Margin="26,22"><Grid.RowDefinitions><RowDefinition Height="24"/><RowDefinition Height="112"/><RowDefinition Height="1"/><RowDefinition Height="105"/><RowDefinition Height="1"/><RowDefinition Height="110"/><RowDefinition Height="22"/></Grid.RowDefinitions>
   <DockPanel><TextBlock Text="WEATHER / BEACON" FontFamily="Segoe UI" FontSize="9" Foreground="#7CA1B9" DockPanel.Dock="Right" VerticalAlignment="Center"/><TextBlock Text="{Binding City}" Foreground="#DEEBF4" FontSize="12" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel>
   <Grid Grid.Row="1"><StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Temperature}" Foreground="#F4F8FC" FontFamily="Segoe UI Variable Display, Segoe UI" FontWeight="Light" FontSize="64" LineHeight="70"/><TextBlock Text="{Binding Description}" Foreground="#ADC5D7" FontSize="13" Margin="3,0,0,6"/></StackPanel><visual:WeatherIcon Kind="{Binding Kind}" Width="94" Height="94" HorizontalAlignment="Right" Margin="0,0,3,0"/></Grid>
   <Border Grid.Row="2" Background="#205D829D"/>
   <ScrollViewer x:Name="HoursScroll" Grid.Row="3" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource Forecast}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer>
   <Border Grid.Row="4" Background="#205D829D"/>
   <ItemsControl Grid.Row="5" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource Forecast}" Margin="0,5,0,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl>
   <TextBlock Grid.Row="6" Text="{Binding Status}" Foreground="#69899F" FontSize="9" VerticalAlignment="Bottom"/>
  </Grid>
 </Grid>
 </Border>
</Window>

