<Window Icon="/WeatherBeacon;component/Assets/WeatherBeacon.ico" x:Class="WeatherBeacon.Features.Widget.WidgetWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:sys="clr-namespace:System;assembly=System.Runtime" xmlns:visual="clr-namespace:WeatherBeacon.Controls" Title="WeatherBeacon 1.0.0.0" SizeToContent="WidthAndHeight" FontFamily="/WeatherBeacon;component/Assets/Fonts/#Source Han Sans SC" UseLayoutRounding="True" SnapsToDevicePixels="True" Typography.NumeralAlignment="Tabular" WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize" Topmost="False" ShowInTaskbar="False">
 <Window.Resources>
  <!-- Text sizes are resources so the font-scale setting can resize every label, including those inside item templates. -->
  <sys:Double x:Key="F10">10</sys:Double><sys:Double x:Key="F11">11</sys:Double><sys:Double x:Key="F12">12</sys:Double><sys:Double x:Key="F13">13</sys:Double><sys:Double x:Key="F14">14</sys:Double><sys:Double x:Key="FTemp">72</sys:Double>
  <Style x:Key="Glass" TargetType="Border"><Setter Property="Background" Value="#96182D40"/><Setter Property="BorderBrush" Value="#60467A85"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="22"/><Setter Property="Padding" Value="16"/></Style>
  <DataTemplate x:Key="Hour"><StackPanel Width="72" Margin="0,0"><TextBlock Text="{Binding Time}" Foreground="#D5E3E8" FontSize="{DynamicResource F11}" HorizontalAlignment="Center"/><visual:WeatherIcon Kind="{Binding Kind}" Width="39" Height="39" Margin="0,13,0,10"/><TextBlock Text="{Binding Temperature}" Foreground="White" FontWeight="SemiBold" FontSize="{DynamicResource F14}" HorizontalAlignment="Center"/></StackPanel></DataTemplate>
  <DataTemplate x:Key="Day"><Border x:Name="Tile" Background="#30152C3C" CornerRadius="12" Width="68" BorderThickness="1" BorderBrush="Transparent" Padding="2,6" Margin="2,0"><StackPanel><TextBlock x:Name="DayLabel" Text="{Binding Description}" ToolTip="{Binding Description}" TextTrimming="CharacterEllipsis" Foreground="#D5E3E8" FontSize="{DynamicResource F10}" HorizontalAlignment="Center"/><TextBlock Text="{Binding Time}" Foreground="White" FontSize="{DynamicResource F12}" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,2,0,4"/><visual:WeatherIcon Kind="{Binding Kind}" Width="36" Height="36"/><TextBlock Text="{Binding Temperature}" TextTrimming="CharacterEllipsis" Foreground="#E0E9ED" FontSize="{DynamicResource F10}" HorizontalAlignment="Center" Margin="0,6,0,0"/></StackPanel></Border><DataTemplate.Triggers><DataTrigger Binding="{Binding IsToday}" Value="True"><Setter TargetName="Tile" Property="Background" Value="#60467A85"/><Setter TargetName="Tile" Property="BorderBrush" Value="#C9E8C783"/><Setter TargetName="DayLabel" Property="Foreground" Value="#E8C783"/></DataTrigger></DataTemplate.Triggers></DataTemplate>
  <!-- Rain reminder: quiet when dry, gold when rain is coming, stronger fill when it is soon or already raining. Colour is never the only cue: the sentence says when. -->
  <Style x:Key="RainPill" TargetType="Border"><Setter Property="Background" Value="#14FFFFFF"/><Setter Property="BorderBrush" Value="#25FFFFFF"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="14"/><Setter Property="Padding" Value="10,6,12,6"/><Setter Property="HorizontalAlignment" Value="Left"/>
   <Style.Triggers>
    <DataTrigger Binding="{Binding RainLevel}" Value="Later"><Setter Property="BorderBrush" Value="#80E8C783"/></DataTrigger>
    <DataTrigger Binding="{Binding RainLevel}" Value="Soon"><Setter Property="Background" Value="#33E8C783"/><Setter Property="BorderBrush" Value="#C9E8C783"/></DataTrigger>
    <DataTrigger Binding="{Binding RainLevel}" Value="Now"><Setter Property="Background" Value="#33E8C783"/><Setter Property="BorderBrush" Value="#C9E8C783"/></DataTrigger>
    <DataTrigger Binding="{Binding ShowRain}" Value="False"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
   </Style.Triggers>
  </Style>
  <Style x:Key="RainInk" TargetType="TextBlock"><Setter Property="Foreground" Value="#CDDBE0"/><Style.Triggers><DataTrigger Binding="{Binding RainLevel}" Value="Later"><Setter Property="Foreground" Value="#F2E3C2"/></DataTrigger><DataTrigger Binding="{Binding RainLevel}" Value="Soon"><Setter Property="Foreground" Value="#FFF4DD"/></DataTrigger><DataTrigger Binding="{Binding RainLevel}" Value="Now"><Setter Property="Foreground" Value="#FFF4DD"/></DataTrigger></Style.Triggers></Style>
  <Style x:Key="RainGlyph" TargetType="Path"><Setter Property="Stroke" Value="#92DAD5"/><Style.Triggers><DataTrigger Binding="{Binding RainLevel}" Value="Later"><Setter Property="Stroke" Value="#E8C783"/></DataTrigger><DataTrigger Binding="{Binding RainLevel}" Value="Soon"><Setter Property="Stroke" Value="#E8C783"/></DataTrigger><DataTrigger Binding="{Binding RainLevel}" Value="Now"><Setter Property="Stroke" Value="#E8C783"/></DataTrigger></Style.Triggers></Style>
 </Window.Resources>
 <Border x:Name="Shell" Width="460" CornerRadius="34" BorderBrush="#A4D6BD8A" BorderThickness="1">
  <Border.Background><LinearGradientBrush StartPoint="0,0" EndPoint=".7,1"><GradientStop Color="#F51C4555" Offset="0"/><GradientStop Color="#F0183046" Offset=".55"/><GradientStop Color="#FF18283D" Offset="1"/></LinearGradientBrush></Border.Background>
  <Grid x:Name="SceneClip">
   <visual:WeatherScene x:Name="Scene" Kind="{Binding Kind}" Opacity=".6"/>
   <Rectangle IsHitTestVisible="False"><Rectangle.Fill><LinearGradientBrush StartPoint="0,0" EndPoint=".6,1"><GradientStop Color="#30132B3B"/><GradientStop Color="#8014273B" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
   <Ellipse Width="210" Height="210" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,15,8,0" IsHitTestVisible="False"><Ellipse.Fill><RadialGradientBrush><GradientStop Color="#40FBBF24"/><GradientStop Color="#00FBBF24" Offset="1"/></RadialGradientBrush></Ellipse.Fill></Ellipse>
   <Path IsHitTestVisible="False" HorizontalAlignment="Left" VerticalAlignment="Top" Stroke="#65E8C783" StrokeThickness="1" Data="M 14,100 L 14,40 Q 14,14 40,14 L 128,14 M 20,85 L 20,42 Q 20,20 42,20 L 100,20"/>
   <Path IsHitTestVisible="False" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,13,13" Stroke="#65E8C783" StrokeThickness="1" Data="M 0,86 L 88,86 Q 114,86 114,60 L 114,0 M 28,80 L 86,80 Q 108,80 108,58 L 108,15"/>
   <Grid x:Name="Body" Margin="26,27,26,23"><Grid.RowDefinitions><RowDefinition Height="34"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Background="#10FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="17" Padding="10,0" HorizontalAlignment="Left"><DockPanel><Ellipse DockPanel.Dock="Left" Width="7" Height="7" Fill="#34D399" Margin="0,0,7,0"/><TextBlock Text="{Binding City}" ToolTip="{Binding City}" Foreground="#EDFFFFFF" FontSize="{DynamicResource F11}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/></DockPanel></Border><TextBlock x:Name="Brand" Grid.Column="1" Text="WeatherBeacon" Foreground="#E8C783" FontFamily="/WeatherBeacon;component/Assets/Fonts/#Source Han Serif SC" FontWeight="Normal" FontSize="{DynamicResource F13}" Margin="16,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Grid x:Name="CurrentRow" Grid.Row="1" Margin="0,8,0,10" MinHeight="124"><StackPanel VerticalAlignment="Center" Margin="0,0,12,0"><TextBlock Text="{Binding Temperature}" Foreground="#FAFFFFFF" FontFamily="/WeatherBeacon;component/Assets/Fonts/#Source Han Sans SC" FontWeight="Light" FontSize="{DynamicResource FTemp}"/><Border Background="#12FFFFFF" BorderBrush="#25FFFFFF" BorderThickness="1" CornerRadius="14" Padding="10,4" HorizontalAlignment="Left"><StackPanel Orientation="Horizontal"><Ellipse Width="5" Height="5" Fill="#E8C783" Margin="0,0,7,0"/><TextBlock Text="{Binding Description}" Foreground="#DEFFFFFF" FontSize="{DynamicResource F11}"/></StackPanel></Border></StackPanel><visual:WeatherIcon x:Name="CurrentWeatherIcon" Kind="{Binding Kind}" Width="108" Height="108" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
    <Border x:Name="RainBanner" Grid.Row="2" Style="{StaticResource RainPill}" Margin="0,0,0,12" ToolTip="根据小米天气逐小时预报，覆盖未来 24 小时"><DockPanel><Path DockPanel.Dock="Left" Style="{StaticResource RainGlyph}" StrokeThickness="1.5" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Data="M 1.5,8 A 6.5,6.5 0 0 1 14.5,8 Z M 8,8 L 8,13 Q 8,15 10,15 Q 11.5,15 11.5,13.5"/><TextBlock Text="{Binding RainHint}" Style="{StaticResource RainInk}" FontSize="{DynamicResource F12}" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel></Border>
    <Border x:Name="HourlyCard" Grid.Row="3" Style="{StaticResource Glass}"><StackPanel><TextBlock Text="◷  逐小时预报" Foreground="#DCE5E6" FontSize="{DynamicResource F11}" Margin="0,0,0,18"/><ScrollViewer x:Name="HoursScroll" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"><ItemsControl ItemsSource="{Binding Hours}" ItemTemplate="{StaticResource Hour}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></ScrollViewer></StackPanel></Border>
    <Border x:Name="DailyCard" Grid.Row="4" Style="{StaticResource Glass}" Margin="0,16,0,0"><StackPanel><TextBlock Text="▣  未来 5 日预报" Foreground="#DCE5E6" FontSize="{DynamicResource F11}" Margin="0,0,0,13"/><ItemsControl ItemsSource="{Binding Days}" ItemTemplate="{StaticResource Day}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel></ItemsControl></StackPanel></Border>
    <TextBlock x:Name="StatusLine" Grid.Row="5" Text="{Binding Status}" Foreground="#CDDBE0" FontSize="{DynamicResource F10}" TextTrimming="CharacterEllipsis" Margin="0,12,0,0"/>
   </Grid>
   <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,65,30,0" Padding="8,3" Background="#D95F4927" CornerRadius="6" IsHitTestVisible="False"><Border.Style><Style TargetType="Border"><Setter Property="Visibility" Value="Collapsed"/><Style.Triggers><DataTrigger Binding="{Binding IsDebugging}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers></Style></Border.Style><TextBlock Text="调试中" Foreground="#FFFFD78A" FontSize="{DynamicResource F10}"/></Border>
  </Grid>
 </Border>
</Window>
